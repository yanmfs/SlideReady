{
  "name": "slideready",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:web": "vite build --mode web --outDir dist-web",
    "build:cli": "vite build --config vite.cli.config.ts && chmod +x dist-cli/slideready.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  },
  "description": "Check a .pptx for broken fonts, links, media and leftover placeholder text before you present.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanmfs/SlideReady.git"
  },
  "keywords": [
    "pptx",
    "presentation",
    "checker",
    "accessibility",
    "tauri",
    "desktop"
  ],
  "packageManager": "pnpm@12.18.0",
  "bin": {
    "slideready": "dist-cli/slideready.mjs"
  }
}
