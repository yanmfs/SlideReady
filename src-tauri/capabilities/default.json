{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/yanmfs/*" }]
    }
  ]
}
